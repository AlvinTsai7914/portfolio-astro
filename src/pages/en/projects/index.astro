---
// ==========================================================================
// English Projects List Page — /en/projects/
// Mirrors zh/projects/index.astro; same logic, English labels.
// ==========================================================================

import { getCollection } from "astro:content";
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import SectionLabel from "../../../components/ui/SectionLabel.astro";
import RevealText from "../../../components/ui/RevealText.astro";

const projects = (await getCollection("projects-en"))
  .sort((a, b) => a.data.order - b.data.order);

const total = String(projects.length).padStart(2, "0");
const years = projects.map((p) => parseInt(p.data.date.slice(0, 4), 10));
const yearRange = `${Math.min(...years)} — ${Math.max(...years)}`;
---

<BaseLayout title="All Works — Alvin Tsai" description="All projects overview" lang="en">
  <section class="projects-list section" data-theme="dark">
    <div class="grid">
      <div class="grid-full">
        <div class="projects-list__hero">
          <!-- 背景超大描邊字(不佔文流,填補右側留黑) -->
          <span class="projects-list__outline" aria-hidden="true">WORK</span>

          <div class="projects-list__hero-top">
            <RevealText delay={0.1}><SectionLabel text="Work" /></RevealText>
            <RevealText delay={0.15}>
              <p class="projects-list__stats">{total} PROJECTS&ensp;/&ensp;{yearRange}</p>
            </RevealText>
          </div>

          <div class="projects-list__hero-main">
            <RevealText pt="var(--space-3)">
              <h1 class="projects-list__headline">All Works</h1>
            </RevealText>

            <div class="projects-list__hero-side">
              <p class="projects-list__desc">Each project a complete journey from concept to launch.</p>
              <div class="view-toggle" role="radiogroup" aria-label="Toggle view mode">
            <button type="button" class="view-toggle__btn" data-mode="slider" aria-pressed="true" aria-label="Slider view">
              <svg class="view-toggle__icon" viewBox="0 0 24 16" aria-hidden="true">
                <rect x="2" y="3" width="5" height="10" fill="none" stroke="currentColor" stroke-width="1.5" />
                <rect x="9.5" y="3" width="5" height="10" fill="none" stroke="currentColor" stroke-width="1.5" />
                <rect x="17" y="3" width="5" height="10" fill="none" stroke="currentColor" stroke-width="1.5" />
              </svg>
            </button>
            <button type="button" class="view-toggle__btn" data-mode="grid" aria-pressed="false" aria-label="Grid view">
              <svg class="view-toggle__icon" viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="3" width="7" height="7" fill="none" stroke="currentColor" stroke-width="1.5" />
                <rect x="14" y="3" width="7" height="7" fill="none" stroke="currentColor" stroke-width="1.5" />
                <rect x="3" y="14" width="7" height="7" fill="none" stroke="currentColor" stroke-width="1.5" />
                <rect x="14" y="14" width="7" height="7" fill="none" stroke="currentColor" stroke-width="1.5" />
              </svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="projects-list__wrap" id="projects-list-wrap">
      <div class="projects-list__container mode-slider" id="projects-list" data-view="slider">
        {projects.map((p, i) => (
          <article class="project-card" data-slug={p.data.slug} data-index={i}>
            <a href={`/en/projects/${p.data.slug}/`} class="project-card__link" data-cursor-text="VIEW PROJECT">
              {/* view-transition-name set dynamically by JS only during mode switch (Phase 4),
                  not in static HTML — otherwise cards float above page-transition mask during SPA nav */}
              <div class="project-card__cover">
                <div class="project-card__img-wrap">
                  {p.data.cover ? (
                    <img src={p.data.cover} alt={p.data.title} class="project-card__img" loading="lazy" draggable="false" />
                  ) : (
                    <div class="project-card__img-placeholder" />
                  )}
                </div>
              </div>
              <div class="project-card__meta">
                <h3 class="project-card__title">
                  {p.data.title}
                </h3>
                <div class="project-card__tags">
                  {p.data.tags.map((tag: string) => (
                    <span class="project-card__tag">{tag}</span>
                  ))}
                </div>
                <p class="project-card__desc">{p.data.description}</p>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>

    <div class="grid">
      <div class="grid-full">
        <div class="slider-controls" id="slider-controls">
          <h2 class="slider-active-title" id="slider-active-title">{projects[0].data.title}</h2>
          <div class="slider-nav">
            <button type="button" class="slider-nav__btn" data-slider-prev aria-label="Previous project">←</button>
            <button type="button" class="slider-nav__btn" data-slider-next aria-label="Next project">→</button>
          </div>
          <div class="slider-progress" id="slider-progress">
            <div class="slider-progress__bar" role="progressbar" aria-valuenow="1" aria-valuemin="1" aria-valuemax={projects.length}>
              <div class="slider-progress__bar-fill"></div>
            </div>
            <span class="slider-progress__count">
              <span id="slider-progress-current">01</span> / {total}
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  // 共用樣式複製自 zh 版(單一來源真理:若要改建議抽成 partial _projects-list.scss)
  .projects-list {
    // 首屏收納:padding 由 space-16 收為 space-8(與 zh 版一致)
    padding-top: calc(var(--site-header-height) + var(--space-8));
    padding-bottom: var(--section-padding);
    min-height: 100vh;
  }

  .projects-list__hero { position: relative; margin-bottom: var(--space-6); }
  .projects-list__outline {
    position: absolute; right: -0.05em; top: -0.18em;
    font-size: clamp(6rem, 16vw, 15rem); font-weight: var(--font-weight-bold, 700);
    line-height: 1; letter-spacing: 0.02em;
    color: transparent; -webkit-text-stroke: 1px rgba(238, 238, 238, 0.1);
    pointer-events: none; user-select: none; z-index: 0;
  }
  .projects-list__hero-top { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-4); }
  .projects-list__stats { font-family: var(--font-mono); font-size: var(--text-body-sm); color: var(--color-foreground-muted); letter-spacing: 0.06em; margin: 0; }
  .projects-list__hero-main { position: relative; z-index: 1; display: flex; align-items: flex-end; justify-content: space-between; gap: var(--space-8); flex-wrap: wrap; }
  .projects-list__headline { font-size: var(--text-h1); margin: 0; }
  .projects-list__hero-side {
    display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-4); padding-bottom: var(--space-3);
    @media (min-width: 768px) { align-items: flex-end; }
  }
  .projects-list__desc { font-size: var(--text-body); color: var(--color-foreground-muted); margin: 0; }

  // 32×32 square icon button,獨立邊框,active 反白
  .view-toggle { display: inline-flex; gap: var(--space-2); }
  .view-toggle__btn {
    width: 32px; height: 32px;
    display: inline-flex; align-items: center; justify-content: center;
    padding: 0;
    color: var(--color-foreground-muted);
    background: transparent;
    border: 1px solid var(--color-border-muted);
    border-radius: 0;
    cursor: pointer;
    transition: color var(--transition-duration), background-color var(--transition-duration), border-color var(--transition-duration);

    &:hover { color: var(--color-foreground); border-color: var(--color-foreground); }
    &[aria-pressed="true"] { background-color: var(--color-foreground); color: var(--color-background); border-color: var(--color-foreground); }
  }
  .view-toggle__icon { width: 18px; height: 18px; display: block; }

  .slider-active-title {
    font-size: var(--text-h4); font-weight: var(--font-weight-medium); letter-spacing: -0.02em;
    margin: 0; min-height: 1em;
    flex: 1 1 100%; // 手機獨佔一行
    // 桌機:彈性填滿,標題長短變化不推擠右側;過長省略
    @media (min-width: 768px) { flex: 1 1 auto; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  }

  .projects-list__wrap { margin-block: var(--space-6); overflow: hidden; }

  .projects-list__container.mode-slider {
    display: flex;
    will-change: transform;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    touch-action: pan-y;

    .project-card, .project-card__link, .project-card__img {
      -webkit-user-drag: none;
      user-drag: none;
    }

    --card-width: 90vw;

    // 寬度同時受視口高度約束(同 zh 版:矮視口下收縮保首屏完整)
    @media (min-width: 768px) { --card-width: min(60vw, calc((100svh - 420px) * 16 / 9)); }
    @media (min-width: 1024px) { --card-width: min(50vw, calc((100svh - 440px) * 16 / 9)); }
    --card-peek: calc((100vw - var(--card-width)) / 2);

    padding-inline: var(--card-peek);

    .project-card {
      flex: 0 0 var(--card-width);
      min-width: 0;
      padding-inline: var(--space-2);
      opacity: 0.4;
      transition: opacity 0.4s var(--ease-out);

      &.is-active { opacity: 1; }

      @media (min-width: 768px) {
        padding-inline: var(--space-4);
      }
    }
    .project-card__title { display: none; }
    // desc 只在 grid 顯示(同 zh 版:首屏收納)
    .project-card__desc { display: none; }
  }

  .projects-list__container.mode-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    padding-inline: var(--grid-margin);

    @media (min-width: 768px) { grid-template-columns: repeat(2, 1fr); }
    @media (min-width: 1024px) { grid-template-columns: repeat(3, 1fr); }

    .project-card { padding-inline: 0; }
  }

  :global(body:has(#projects-list.mode-grid)) .slider-active-title,
  :global(body:has(#projects-list.mode-grid)) #slider-controls { display: none; }

  .project-card { display: block; }
  .project-card__link { display: block; color: inherit; text-decoration: none; }
  .project-card__cover { display: block; width: 100%; aspect-ratio: 16 / 9; overflow: hidden; background-color: var(--color-surface); margin-bottom: var(--space-4); }
  // wrap 由 GSAP 控制 translateX(視差);img 自己用 transform: scale 放大
  .project-card__img-wrap { width: 100%; height: 100%; }
  .project-card__img, .project-card__img-placeholder {
    width: 100%; height: 100%; object-fit: cover; display: block;
    background-color: var(--color-surface);
    transform: scale(1.2);
  }

  .project-card__meta { display: flex; flex-direction: column; gap: var(--space-3); }
  .project-card__title { font-size: var(--text-h4); font-weight: var(--font-weight-medium); margin: 0; }
  .project-card__tags { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .project-card__tag { font-family: var(--font-mono); font-size: var(--text-body-sm); padding: var(--space-1) var(--space-3); border: 1px solid var(--color-border-muted); border-radius: var(--radius-full); color: var(--color-foreground-muted); }
  .project-card__desc { font-size: var(--text-body); color: var(--color-foreground-muted); line-height: 1.5; margin: 0; }

  .slider-controls { display: flex; align-items: center; gap: var(--space-6); margin-top: var(--space-4); flex-wrap: wrap; }
  .slider-nav { display: flex; gap: var(--space-2); }
  .slider-nav__btn {
    width: 40px; height: 40px;
    display: inline-flex; align-items: center; justify-content: center;
    font-family: var(--font-mono); font-size: var(--text-body);
    color: var(--color-foreground);
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.3); border-radius: var(--radius-full);
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;

    &:hover { background-color: var(--color-foreground); color: var(--color-background); border-color: var(--color-foreground); }
    &:disabled { opacity: 0.3; cursor: not-allowed; &:hover { background-color: rgba(255, 255, 255, 0.04); color: var(--color-foreground); border-color: rgba(255, 255, 255, 0.3); } }
  }

  .slider-progress {
    display: flex; align-items: center; gap: var(--space-4); flex: 1; min-width: 200px;
    // 桌機固定寬:標題變化時進度條位置恆定
    @media (min-width: 768px) { flex: 0 0 280px; min-width: 0; }
  }
  .slider-progress__bar { flex: 1; height: 1px; background-color: rgba(238, 238, 238, 0.1); position: relative; overflow: hidden; cursor: pointer; }
  .slider-progress__bar-fill { position: absolute; top: 0; left: 0; height: 100%; width: calc(var(--progress, 0) * 100%); background-color: var(--color-brand); transition: width 0.6s var(--ease-out); }
  .slider-progress__count { font-family: var(--font-mono); font-size: var(--text-body-sm); color: var(--color-foreground-muted); flex-shrink: 0; }
</style>
