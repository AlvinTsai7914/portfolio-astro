---
// ==========================================================================
// 中文專案列表頁 — /zh/projects/
// 雙模式:Slider(預設)/ Grid,localStorage 記住
// 動畫:View Transitions API + GSAP FLIP 降級(見 src/scripts/projects-list.ts)
//
// 此檔只處理靜態 DOM 結構與 CSS。mode 切換、slider 互動、scramble 由 JS 控制。
// ==========================================================================

import { getCollection } from "astro:content";
import BaseLayout from "../../../components/layout/BaseLayout.astro";
import SectionLabel from "../../../components/ui/SectionLabel.astro";
import RevealText from "../../../components/ui/RevealText.astro";

const projects = (await getCollection("projects-zh"))
  .sort((a, b) => a.data.order - b.data.order);

const total = String(projects.length).padStart(2, "0");
const years = projects.map((p) => parseInt(p.data.date.slice(0, 4), 10));
const yearRange = `${Math.min(...years)} — ${Math.max(...years)}`;
---

<BaseLayout title="作品總覽 — 蔡承初" description="所有作品總覽" lang="zh">
  <section class="projects-list section" data-theme="dark">
    <!-- Hero(兩 mode 共用) -->
    <div class="grid">
      <div class="grid-full">
        <div class="projects-list__hero">
          <!-- 背景超大描邊字(不佔文流,填補右側留黑) -->
          <span class="projects-list__outline" aria-hidden="true">WORK</span>

          <div class="projects-list__hero-top">
            <RevealText delay={0.1}><SectionLabel text="Work" /></RevealText>
            <RevealText delay={0.15}>
              <p class="projects-list__stats">{total} PROJECTS&ensp;/&ensp;{yearRange}</p>
            </RevealText>
          </div>

          <div class="projects-list__hero-main">
            <RevealText pt="var(--space-3)">
              <h1 class="projects-list__headline">作品總覽</h1>
            </RevealText>

            <div class="projects-list__hero-side">
              <p class="projects-list__desc">由概念到上線的完整實踐。</p>
              <!-- View Mode Toggle(32x32 icon button,獨立邊框,active 反白) -->
              <div class="view-toggle" role="radiogroup" aria-label="切換檢視模式">
                <button type="button" class="view-toggle__btn" data-mode="slider" aria-pressed="true" aria-label="Slider 檢視">
                  <svg class="view-toggle__icon" viewBox="0 0 24 16" aria-hidden="true">
                    <rect x="2" y="3" width="5" height="10" fill="none" stroke="currentColor" stroke-width="1.5" />
                    <rect x="9.5" y="3" width="5" height="10" fill="none" stroke="currentColor" stroke-width="1.5" />
                    <rect x="17" y="3" width="5" height="10" fill="none" stroke="currentColor" stroke-width="1.5" />
                  </svg>
                </button>
                <button type="button" class="view-toggle__btn" data-mode="grid" aria-pressed="false" aria-label="Grid 檢視">
                  <svg class="view-toggle__icon" viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="3" y="3" width="7" height="7" fill="none" stroke="currentColor" stroke-width="1.5" />
                    <rect x="14" y="3" width="7" height="7" fill="none" stroke="currentColor" stroke-width="1.5" />
                    <rect x="3" y="14" width="7" height="7" fill="none" stroke="currentColor" stroke-width="1.5" />
                    <rect x="14" y="14" width="7" height="7" fill="none" stroke="currentColor" stroke-width="1.5" />
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Projects list container(mode 由 class 控制) -->
    <div class="projects-list__wrap" id="projects-list-wrap">
      <div class="projects-list__container mode-slider" id="projects-list" data-view="slider">
        {projects.map((p, i) => (
          <article class="project-card" data-slug={p.data.slug} data-index={i}>
            <a href={`/zh/projects/${p.data.slug}/`} class="project-card__link" data-cursor-text="查看作品">
              {/* view-transition-name 不放靜態 HTML,避免 SPA 頁面切換時卡片浮在 page-transition 遮罩上方。
                  Phase 4(slider↔grid 切換動畫)需要時由 JS 動態 setProperty 後再清除 */}
              <div class="project-card__cover">
                <div class="project-card__img-wrap">
                  {p.data.cover ? (
                    <img src={p.data.cover} alt={p.data.title} class="project-card__img" loading="lazy" draggable="false" />
                  ) : (
                    <div class="project-card__img-placeholder" />
                  )}
                </div>
              </div>
              <div class="project-card__meta">
                <h3 class="project-card__title">
                  {p.data.title}
                </h3>
                <div class="project-card__tags">
                  {p.data.tags.map((tag: string) => (
                    <span class="project-card__tag">{tag}</span>
                  ))}
                </div>
                <p class="project-card__desc">{p.data.description}</p>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>

    <!-- Slider 控制列(Grid mode 隱藏):prev/next + 進度條 -->
    <div class="grid">
      <div class="grid-full">
        <div class="slider-controls" id="slider-controls">
          <!-- Slider 專用:active 卡片標題(scramble 切換,id 供 JS 取用) -->
          <h2 class="slider-active-title" id="slider-active-title">{projects[0].data.title}</h2>
          <div class="slider-nav">
            <button type="button" class="slider-nav__btn" data-slider-prev aria-label="前一個專案">←</button>
            <button type="button" class="slider-nav__btn" data-slider-next aria-label="下一個專案">→</button>
          </div>
          <div class="slider-progress" id="slider-progress">
            <div class="slider-progress__bar" role="progressbar" aria-valuenow="1" aria-valuemin="1" aria-valuemax={projects.length}>
              <div class="slider-progress__bar-fill"></div>
            </div>
            <span class="slider-progress__count">
              <span id="slider-progress-current">01</span> / {total}
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  // ==========================================================================
  // Section
  // ==========================================================================
  .projects-list {
    // 首屏收納:padding 由 space-16 收為 space-8,配合 hero 壓縮讓
    // 1440×900 / 1920×1080 首屏能完整看到卡片(圖+tags)與控制列
    padding-top: calc(var(--site-header-height) + var(--space-8));
    padding-bottom: var(--section-padding);
    min-height: 100vh;
  }

  // ==========================================================================
  // Hero(兩行水平佈局:label+統計 / 標題+desc+toggle,壓縮首屏高度)
  // ==========================================================================
  .projects-list__hero {
    position: relative;
    margin-bottom: var(--space-6);
  }

  // 背景超大描邊字:絕對定位不佔文流,低對比填補右側留黑
  .projects-list__outline {
    position: absolute;
    right: -0.05em;
    top: -0.18em;
    font-size: clamp(6rem, 16vw, 15rem);
    font-weight: var(--font-weight-bold, 700);
    line-height: 1;
    letter-spacing: 0.02em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(238, 238, 238, 0.1);
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .projects-list__hero-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .projects-list__stats {
    font-family: var(--font-mono);
    font-size: var(--text-body-sm);
    color: var(--color-foreground-muted);
    letter-spacing: 0.06em;
    margin: 0;
  }

  .projects-list__hero-main {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  .projects-list__headline {
    font-size: var(--text-h1);
    margin: 0;
  }

  .projects-list__hero-side {
    display: flex;
    flex-direction: column;
    align-items: flex-start; // 手機:換行後靠左
    gap: var(--space-4);
    padding-bottom: var(--space-3); // 與 h1 基線的視覺對齊

    @media (min-width: 768px) {
      align-items: flex-end;
    }
  }

  .projects-list__desc {
    font-size: var(--text-body);
    color: var(--color-foreground-muted);
    margin: 0;
  }

  // --------------------------------------------------------------------------
  // View Mode Toggle — 32×32 正方形 icon button,獨立邊框,active 整顆反白
  // --------------------------------------------------------------------------
  .view-toggle {
    display: inline-flex;
    gap: var(--space-2);
  }

  .view-toggle__btn {
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    color: var(--color-foreground-muted);
    background: transparent;
    border: 1px solid var(--color-border-muted);
    border-radius: 0;
    cursor: pointer;
    transition:
      color var(--transition-duration) var(--transition-timing),
      background-color var(--transition-duration) var(--transition-timing),
      border-color var(--transition-duration) var(--transition-timing);

    &:hover {
      color: var(--color-foreground);
      border-color: var(--color-foreground);
    }

    &[aria-pressed="true"] {
      background-color: var(--color-foreground);
      color: var(--color-background);
      border-color: var(--color-foreground);
    }
  }

  .view-toggle__icon {
    width: 18px;
    height: 18px;
    display: block;
  }

  // --------------------------------------------------------------------------
  // Slider Active Title(移入控制列同行,壓縮首屏高度)
  // --------------------------------------------------------------------------
  .slider-active-title {
    font-size: var(--text-h4);
    font-weight: var(--font-weight-medium);
    letter-spacing: -0.02em;
    margin: 0;
    min-height: 1em; // 預留空間避免 scramble 時跳動
    flex: 1 1 100%; // 手機:獨佔一行

    // 桌機:彈性填滿剩餘寬度(標題長短變化由自身吸收,不推擠右側 nav/進度條),
    // 過長以省略號截斷
    @media (min-width: 768px) {
      flex: 1 1 auto;
      min-width: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }

  // ==========================================================================
  // Projects List Container(共用 DOM,mode 切換 class)
  // ==========================================================================
  // wrap 當 slider 的 viewport(overflow: hidden),container 做 translateX
  .projects-list__wrap {
    margin-block: var(--space-6);
    overflow: hidden;
  }

  // --------------------------------------------------------------------------
  // Mode: Slider(水平排列 + GSAP translateX)
  // Mobile: active 90vw + 兩側各 5vw peek
  // Tablet: active 75vw + 兩側各 12.5vw peek
  // Desktop: active 65vw + 兩側各 17.5vw peek
  // --------------------------------------------------------------------------
  .projects-list__container.mode-slider {
    display: flex;
    flex-direction: row;
    gap: 0;
    will-change: transform;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    // 縱向滑頁交給瀏覽器,水平手勢交給 JS(JS 用方向鎖定區分,見 projects-list.ts)
    touch-action: pan-y;

    // 禁止圖片/連結觸發瀏覽器原生 HTML5 拖曳(會搶走 pointermove 事件)
    .project-card,
    .project-card__link,
    .project-card__img {
      -webkit-user-drag: none;
      user-drag: none;
    }

    --card-width: 90vw;

    @media (min-width: 768px) {
      // 寬度同時受視口高度約束:矮視口(如 1366×768 筆電)下寬度自動收縮,
      // 保證首屏能看到卡片圖底部(常數 = 首屏固定開銷:header+hero+margins+tags+控制列)
      --card-width: min(60vw, calc((100svh - 420px) * 16 / 9));
    }

    @media (min-width: 1024px) {
      --card-width: min(50vw, calc((100svh - 440px) * 16 / 9));
    }

    // peek 由剩餘寬度均分,任何 card-width 下首尾卡都置中
    --card-peek: calc((100vw - var(--card-width)) / 2);
    padding-inline: var(--card-peek);

    .project-card {
      flex: 0 0 var(--card-width);
      min-width: 0;
      padding-inline: var(--space-2); // 手機版較小間距
      opacity: 0.4;
      transition: opacity 0.4s var(--ease-out);

      &.is-active {
        opacity: 1;
      }

      @media (min-width: 768px) {
        padding-inline: var(--space-4);
      }
    }

    // Slider mode 下隱藏每張卡片自己的 title(由 slider-active-title 取代)
    .project-card__title {
      display: none;
    }

    // Slider mode 下隱藏 desc(2026-09-30 改:封面已有六案六風格的視覺量,
    // desc 與詳細頁/grid 重複;隱藏後首屏可完整收納 圖+tags+控制列)
    .project-card__desc {
      display: none;
    }
  }

  // --------------------------------------------------------------------------
  // Mode: Grid(1/2/3 欄 RWD)
  // --------------------------------------------------------------------------
  .projects-list__container.mode-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    padding-inline: var(--grid-margin);

    @media (min-width: 768px) {
      grid-template-columns: repeat(2, 1fr);
    }

    @media (min-width: 1024px) {
      grid-template-columns: repeat(3, 1fr);
    }

    .project-card {
      padding-inline: 0;
    }
  }

  // Grid mode 下隱藏 slider 專屬元件(控制列、active title)
  :global(body:has(#projects-list.mode-grid)) .slider-active-title,
  :global(body:has(#projects-list.mode-grid)) #slider-controls {
    display: none;
  }

  // Slider mode meta 顯示策略:保留 tags、隱藏 desc(見 .mode-slider 內註解)

  // ==========================================================================
  // Project Card
  // ==========================================================================
  .project-card {
    display: block;
  }

  .project-card__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .project-card__cover {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--color-surface);
    margin-bottom: var(--space-4);
  }

  // wrap 由 GSAP 控制 translateX(視差);img 自己用 transform: scale 放大
  // 兩者拆開避免 transform 衝突
  .project-card__img-wrap {
    width: 100%;
    height: 100%;
  }

  .project-card__img,
  .project-card__img-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    background-color: var(--color-surface);
    transform: scale(1.2); // 圖片放大到 120%(超出由 cover overflow:hidden 裁切)
  }

  .project-card__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .project-card__title {
    font-size: var(--text-h4);
    font-weight: var(--font-weight-medium);
    margin: 0;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .project-card__tag {
    font-family: var(--font-mono);
    font-size: var(--text-body-sm);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border-muted);
    border-radius: var(--radius-full);
    color: var(--color-foreground-muted);
  }

  .project-card__desc {
    font-size: var(--text-body);
    color: var(--color-foreground-muted);
    line-height: 1.5;
    margin: 0;
  }

  // ==========================================================================
  // Slider 控制列(prev/next + 進度條)
  // ==========================================================================
  .slider-controls {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    margin-top: var(--space-4);
    flex-wrap: wrap;

    // 桌機禁止換行:長標題被壓縮走 ellipsis,而不是把 nav/進度條擠到第二行
    @media (min-width: 768px) {
      flex-wrap: nowrap;
    }
  }

  .slider-nav {
    display: flex;
    gap: var(--space-2);
  }

  .slider-nav__btn {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: var(--text-body);
    color: var(--color-foreground);
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition:
      background-color var(--transition-duration) var(--transition-timing),
      color var(--transition-duration) var(--transition-timing),
      border-color var(--transition-duration) var(--transition-timing);

    &:hover {
      background-color: var(--color-foreground);
      color: var(--color-background);
      border-color: var(--color-foreground);
    }

    &:disabled {
      opacity: 0.3;
      cursor: not-allowed;
      &:hover {
        background-color: rgba(255, 255, 255, 0.04);
        color: var(--color-foreground);
        border-color: rgba(255, 255, 255, 0.3);
      }
    }
  }

  .slider-progress {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex: 1;
    min-width: 200px;

    // 桌機固定寬(與視口連動但不隨標題變化):1440 約 792px、1920 封頂 860px,
    // 標題文字變化時進度條位置恆定不跳動
    @media (min-width: 768px) {
      flex: 0 0 clamp(320px, 55vw, 860px);
      min-width: 0;
    }
  }

  .slider-progress__bar {
    flex: 1;
    height: 1px;
    background-color: rgba(238, 238, 238, 0.1);
    position: relative;
    overflow: hidden;
    cursor: pointer;
  }

  .slider-progress__bar-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: calc(var(--progress, 0) * 100%);
    background-color: var(--color-brand);
    transition: width 0.6s var(--ease-out);
  }

  .slider-progress__count {
    font-family: var(--font-mono);
    font-size: var(--text-body-sm);
    color: var(--color-foreground-muted);
    flex-shrink: 0;
  }
</style>
